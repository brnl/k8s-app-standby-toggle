{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "type": "object",
  "additionalProperties": false,
  "definitions": {
    "duration": {
      "type": "string",
      "pattern": "^([0-9]+(\\.[0-9]+)?(ns|us|µs|ms|s|m|h))+$"
    },
    "dnsLabel": {
      "type": "string",
      "pattern": "^[a-z0-9]([a-z0-9-]{0,61}[a-z0-9])?$"
    }
  },
  "properties": {
    "global": {
      "type": "object"
    },
    "groups": {
      "type": "object",
      "description": "Group name to default and Argo CD Applications.",
      "propertyNames": {
        "pattern": "^[a-z0-9]([a-z0-9-]{0,61}[a-z0-9])?$"
      },
      "additionalProperties": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "default": {
            "type": "string",
            "enum": [
              "always-on",
              "awake",
              "asleep"
            ],
            "description": "Not on/off: Helm reads unquoted on/off as booleans."
          },
          "apps": {
            "type": "array",
            "minItems": 1,
            "uniqueItems": true,
            "items": {
              "type": "string",
              "pattern": "^[a-z0-9]([a-z0-9.-]{0,251}[a-z0-9])?$"
            }
          }
        },
        "required": [
          "default",
          "apps"
        ]
      }
    },
    "argocd": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "namespace": {
          "$ref": "#/definitions/dnsLabel"
        }
      }
    },
    "reconcileInterval": {
      "$ref": "#/definitions/duration"
    },
    "wakeDurations": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/definitions/duration"
      }
    },
    "hold": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "defaultDuration": {
          "$ref": "#/definitions/duration"
        },
        "maxDuration": {
          "$ref": "#/definitions/duration"
        }
      }
    },
    "lease": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "maxDuration": {
          "$ref": "#/definitions/duration"
        }
      }
    },
    "degradedAfter": {
      "$ref": "#/definitions/duration"
    },
    "databaseWait": {
      "$ref": "#/definitions/duration"
    },
    "conflict": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "threshold": {
          "type": "integer",
          "minimum": 2
        },
        "window": {
          "$ref": "#/definitions/duration"
        }
      }
    },
    "annotationPrefix": {
      "type": "string",
      "pattern": "^[a-z0-9]([a-z0-9.-]*[a-z0-9])?/$"
    },
    "oidc": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "issuerURL": {
          "type": "string",
          "pattern": "^(https://.+)?$"
        },
        "clientID": {
          "type": "string",
          "minLength": 1
        },
        "redirectURL": {
          "type": "string",
          "pattern": "^(https://[^/]+/auth/callback)?$"
        },
        "allowedGroups": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "allowAnyUser": {
          "type": "boolean"
        },
        "ca": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "configMap": {
              "type": "string"
            },
            "secret": {
              "type": "string"
            },
            "key": {
              "type": "string",
              "minLength": 1
            }
          }
        },
        "sessionTTL": {
          "$ref": "#/definitions/duration"
        },
        "sessionKeySecret": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "name": {
              "type": "string"
            },
            "key": {
              "type": "string",
              "minLength": 1
            }
          }
        }
      }
    },
    "machineAuth": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "audience": {
          "type": "string",
          "minLength": 1
        },
        "subjects": {
          "type": "array",
          "items": {
            "type": "string",
            "pattern": "^system:serviceaccount:[a-z0-9]([a-z0-9-]{0,61}[a-z0-9])?:[a-z0-9]([a-z0-9.-]{0,251}[a-z0-9])?$"
          }
        }
      }
    },
    "log": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "level": {
          "type": "string",
          "enum": [
            "debug",
            "info",
            "warn",
            "error"
          ]
        },
        "format": {
          "type": "string",
          "enum": [
            "json",
            "text"
          ]
        }
      }
    },
    "extraEnv": {
      "type": "array",
      "items": {
        "type": "object"
      }
    },
    "image": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "repository": {
          "type": "string",
          "minLength": 1
        },
        "tag": {
          "type": "string"
        },
        "digest": {
          "type": "string",
          "pattern": "^(sha256:[a-f0-9]{64})?$"
        },
        "pullPolicy": {
          "type": "string",
          "enum": [
            "Always",
            "IfNotPresent",
            "Never"
          ]
        }
      }
    },
    "imagePullSecrets": {
      "type": "array",
      "items": {
        "type": "object"
      }
    },
    "nameOverride": {
      "type": "string"
    },
    "fullnameOverride": {
      "type": "string"
    },
    "containerPort": {
      "type": "integer",
      "minimum": 1024,
      "maximum": 65535
    },
    "service": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "type": {
          "type": "string",
          "enum": [
            "ClusterIP",
            "NodePort",
            "LoadBalancer"
          ]
        },
        "port": {
          "type": "integer",
          "minimum": 1,
          "maximum": 65535
        },
        "annotations": {
          "type": "object",
          "additionalProperties": {
            "type": "string"
          }
        }
      }
    },
    "httpRoute": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "enabled": {
          "type": "boolean"
        },
        "annotations": {
          "type": "object",
          "additionalProperties": {
            "type": "string"
          }
        },
        "labels": {
          "type": "object",
          "additionalProperties": {
            "type": "string"
          }
        },
        "parentRefs": {
          "type": "array",
          "items": {
            "type": "object"
          }
        },
        "hostnames": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      }
    },
    "metrics": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "serviceMonitor": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "enabled": {
              "type": "boolean"
            },
            "interval": {
              "$ref": "#/definitions/duration"
            },
            "scrapeTimeout": {
              "$ref": "#/definitions/duration"
            },
            "labels": {
              "type": "object",
              "additionalProperties": {
                "type": "string"
              }
            },
            "annotations": {
              "type": "object",
              "additionalProperties": {
                "type": "string"
              }
            },
            "relabelings": {
              "type": "array",
              "items": {
                "type": "object"
              }
            },
            "metricRelabelings": {
              "type": "array",
              "items": {
                "type": "object"
              }
            }
          }
        }
      }
    },
    "serviceAccount": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "name": {
          "type": "string"
        },
        "annotations": {
          "type": "object",
          "additionalProperties": {
            "type": "string"
          }
        }
      }
    },
    "podAnnotations": {
      "type": "object",
      "additionalProperties": {
        "type": "string"
      }
    },
    "podLabels": {
      "type": "object",
      "additionalProperties": {
        "type": "string"
      }
    },
    "podSecurityContext": {
      "type": "object"
    },
    "securityContext": {
      "type": "object"
    },
    "resources": {
      "type": "object"
    },
    "livenessProbe": {
      "type": [
        "object",
        "null"
      ]
    },
    "readinessProbe": {
      "type": [
        "object",
        "null"
      ]
    },
    "priorityClassName": {
      "type": "string"
    },
    "nodeSelector": {
      "type": "object",
      "additionalProperties": {
        "type": "string"
      }
    },
    "tolerations": {
      "type": "array",
      "items": {
        "type": "object"
      }
    },
    "affinity": {
      "type": "object"
    },
    "revisionHistoryLimit": {
      "type": "integer",
      "minimum": 0
    }
  }
}
